# Copy to .env.local. Every feature runs in preview mode when its keys are missing.

NEXT_PUBLIC_SITE_URL=https://www.accordingtomodishyeblog.com

# Mailchimp newsletter
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_AUDIENCE_ID=

# Contact form delivery via Resend
RESEND_API_KEY=
CONTACT_TO=support@accordingtomodishyeblog.com

# Shopify Starter storefront, e.g. modishye.myshopify.com
NEXT_PUBLIC_SHOPIFY_DOMAIN=

# Sanity, the publishing portal. Leave the project id blank and the site reads content/*.json instead.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Viewer token. Lets "Preview on site" show unpublished drafts. Server only.
SANITY_API_READ_TOKEN=
# Editor token. Used once by scripts/migrate-to-sanity.mjs, then can be deleted.
SANITY_API_WRITE_TOKEN=
# Any long random string. Set the same value on the Sanity webhook that points at /api/revalidate.
SANITY_REVALIDATE_SECRET=
# Where /studio, /wp-admin and /wp-login.php send her.
NEXT_PUBLIC_SANITY_STUDIO_URL=https://modishye.sanity.studio
